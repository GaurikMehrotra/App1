# Copy to apps/campus/.env.local; these are public client settings, never service keys.
EXPO_PUBLIC_APP_NAME=[APP_NAME]
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_AI_ENABLED=false
# Supabase Edge Functions only, set using supabase secrets set:
# AI_PROVIDER_URL, AI_PROVIDER_KEY, RAZORPAY_KEY_ID (rzp_test_ only), RAZORPAY_KEY_SECRET
