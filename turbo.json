{
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@campus/core#build": {
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "EXPO_*",
    "__UNSAFE_EXPO_HOME_DIRECTORY",
    "CI",
    "XDG_DATA_HOME",
    "XDG_CACHE_HOME"
  ]
}
